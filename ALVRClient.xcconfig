// Signing identity. These defaults keep the repo buildable; set your own values
// locally in Override.xcconfig (gitignored). Do NOT put personal team / bundle IDs here.
ALVR_DEVELOPMENT_TEAM =
ALVR_BUNDLE_ID = alvr.client
ALVR_APP_GROUP = group.alvr.client.ALVR

DEVELOPMENT_TEAM = $(ALVR_DEVELOPMENT_TEAM)

#include? "AppStore.xcconfig"
#include? "Override.xcconfig"
